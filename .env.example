# Local development only: these are public demo credentials, not production secrets.
# Remove DATABASE_URL to use browser-only demo mode.
DATABASE_URL=postgresql://weekend:weekend_local_dev@localhost:5432/weekend
ROUTING_URL=https://router.project-osrm.org/route/v1/driving
# A walking-capable OSRM-compatible service. The driving demo cannot route walks.
# WALKING_ROUTING_URL=https://your-walking-service/route/v1/foot
# Local S3rver (npm run storage:dev), persistent files in .storage/.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=weekend
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
# For production replace S3_* with your provider's settings.
# By default private media is streamed through /api/media/ with range support.
# Optionally serve uploaded objects directly from a public-read CDN:
# S3_PUBLIC_URL=https://cdn.example.com/weekend

# 2GIS MapGL JS API: browser key, visible to visitors. Restrict it to your domains
# and MapGL only in the 2GIS account. Do not reuse server-side service keys here.
# Set in Vercel (Production / Preview), then rebuild to include it in the client.
# Without a key or if MapGL fails, the existing overview map remains available.
NEXT_PUBLIC_DGIS_MAP_KEY=

# 2GIS Places + Routing (server-only). Never put this in NEXT_PUBLIC_*.
# Preferred name: DGIS_API_KEY. If Vercel already has DGIS_KEY, that alias is also read.
# Without a server key, routing falls back to OSRM/straight and hotels/meals use search links.
# DGIS_API_KEY=
# DGIS_KEY=
